# 复制为 deploy/.env 后修改。不要把真实密码/密钥提交到 git。
POSTGRES_PASSWORD=change-this-db-password
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-bytes
ADMIN_USERNAME=admin
# 首次启动管理员密码；不设置则随机生成并打印在 api 日志里
ADMIN_PASSWORD=change-this-admin-password
# Fernet key；留空时由 JWT_SECRET 派生。生成命令：
# python -c "import base64,hashlib;print(base64.urlsafe_b64encode(hashlib.sha256(b'your-secret').digest()).decode())"
COOKIE_ENCRYPTION_KEY=
# mock = 使用录制样本，不访问微博；http = 真实 Cookie 采集
CRAWLER_MODE=mock
CRAWL_RATE_LIMIT_SECONDS=2.5
RAW_RETENTION_DAYS=90
